# 复制本文件为 .env 并按需修改
# .env 已加入 .gitignore,不会被提交

# Flora 项目 URL
FLORA_PROJECT_URL=https://app.flora.ai/projects/ns71wphw21tmp3w91sp17c65xs86ngqj

# 账号文件(每行 email----password----clientID----refreshToken)
ACCOUNTS_FILE=./outlook/outlook1.txt

# 素材文件夹(每个子目录 = 一个生成任务,需包含图片 + prompt.txt)
MATERIALS_DIR=./素材

# 浏览器用户数据目录前缀
# 每个账号会落到 <prefix>/<email-slug>/ 下,登录态持久化,后续跑无须重登
USER_DATA_DIR_PREFIX=./.browser_profile

# 调试 / 运行参数
HEADLESS=false           # false=显示浏览器窗口,首次跑务必 false 以便看清流程
SLOW_MO_MS=150           # 每步操作间延迟毫秒数,熟练后可设 0
GENERATION_TIMEOUT_S=600 # 单个视频等待生成完成的最长秒数
PER_ACCOUNT_QUOTA=3      # 每个账号最多生成多少个视频后切换下一个
